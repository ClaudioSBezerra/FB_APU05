# FB_APU05 — Variáveis de ambiente de produção (Coolify)
# Configurar na aba "Environment Variables" do Coolify — nunca commitar
# os valores reais num .env dentro do repo.

# Domínio final da aplicação (web + api, mesma origem — ver frontend/nginx.conf)
APP_URL=https://controladoria.fbtax.cloud

# Postgres (role owner — roda as migrations no boot do backend)
DB_USER=fb_apu05
DB_PASSWORD=
DB_NAME=fb_apu05

# Roles restritas criadas pela migration 010 (AD-4). A migration grava a
# senha 'changeme' de forma estática — ela NÃO lê estas vars. Depois do
# primeiro deploy, rodar manualmente (via Coolify "Terminal" ou psql):
#   ALTER ROLE fb_apu05_app PASSWORD 'o-mesmo-valor-de-DB_APP_PASSWORD';
#   ALTER ROLE fb_apu05_privilegiado PASSWORD 'o-mesmo-valor-de-DB_PRIVILEGIADA_PASSWORD';
# e só então redeploy/restart o serviço `api` para ele reconectar com a
# senha nova.
DB_APP_PASSWORD=
DB_PRIVILEGIADA_PASSWORD=

# Segredos da aplicação — gerar valores aleatórios únicos de produção
JWT_SECRET=
ENCRYPTION_KEY=

# SSO Keycloak (AD-6) — deixar em branco até o IdP de produção existir;
# o backend sobe com SSO desabilitado sem estas vars.
IAM_BASE_URL=
IAM_CLIENT_ID=
IAM_REDIRECT_URI=
IAM_ALLOWED_CLIENT_IDS=
IAM_SCOPES=
