# Postgres
# DATABASE_URL: só o runner de migrations (onDBConnected, main.go) usa esta
# conexão — precisa ser uma role owner/superuser das tabelas (REVOKE não tem
# efeito sobre owner/superuser, Design Notes da Story 4.1).
DATABASE_URL=postgres://fb_apu05:fb_apu05@localhost:5432/fb_apu05?sslmode=disable
# DATABASE_URL_APP (Story 4.1, AD-4): conexão geral usada por TODOS os
# handlers (withDB) — role fb_apu05_app, criada pela migration 010, sem
# GRANT UPDATE em aprovador_snapshot/versao/status/administrador_id de
# `solicitacoes`. Senha dev default "changeme", mesmo padrão de
# JWT_SECRET/ENCRYPTION_KEY — a migration 010 cria a role com essa senha
# literal (arquivo de migration é texto estático, não lê este env var).
DATABASE_URL_APP=postgres://fb_apu05_app:changeme@localhost:5432/fb_apu05?sslmode=disable
# DATABASE_URL_PRIVILEGIADA (Story 4.1, AD-4): conexão usada exclusivamente
# por internal/fila (withPrivilegedDB) — role fb_apu05_privilegiado, a
# ÚNICA com GRANT UPDATE nessas 4 colunas. Mesma senha dev default.
DATABASE_URL_PRIVILEGIADA=postgres://fb_apu05_privilegiado:changeme@localhost:5432/fb_apu05?sslmode=disable

# Autenticação — JWT próprio emitido pelo backend (AD-6/AD-9); troque em produção
JWT_SECRET=changeme-local-dev-secret
ENCRYPTION_KEY=changeme-local-dev-key

# Servidor
PORT=8081
COOKIE_SECURE=false
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# SSO Keycloak (AD-6) — client isolado fb-apu05, nunca reaproveita nem toca na
# configuração do fb-apu02. As 4 vars abaixo precisam estar TODAS setadas para
# o botão/auto-redirect de SSO aparecer no frontend (ver SSOConfigHandler).
# Client "fb-apu05" precisa ser provisionado manualmente no realm Keycloak
# ferreiracosta antes do login funcionar ponta a ponta (ver spec Design Notes).
IAM_BASE_URL=https://iam.fcxlabs.com/realms/ferreiracosta
IAM_CLIENT_ID=fb-apu05
IAM_REDIRECT_URI=http://localhost:3000/auth/callback
IAM_ALLOWED_CLIENT_IDS=fb-apu05
# Opcional — default "openid profile email" se omitida
IAM_SCOPES=openid profile email
